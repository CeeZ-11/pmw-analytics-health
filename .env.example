# PMW Analytics Health — build-time configuration.
#
# Copy to `.env.local` for local development. In GitHub Actions these come
# from repository *Variables* (Settings → Secrets and variables → Actions →
# Variables), NOT Secrets.
#
# IMPORTANT: every VITE_* value is compiled into the public JavaScript bundle
# that GitHub Pages serves to anyone. Never put a credential here — no GA4
# service-account JSON, Google private keys, n8n API keys/basic-auth,
# Slack tokens or webhook secrets. Those live only inside n8n.

# Where the dashboard reads its data from:
#   mock — bundled sample data (default; clearly labelled "Sample data" in the UI)
#   api  — the n8n webhook/API endpoints under VITE_API_BASE_URL
VITE_DATA_SOURCE=mock

# Base URL of the n8n read endpoints, without a trailing slash. The app
# appends /sites, /sites/:id, /sites/:id/history and /health-summary.
# Example: https://n8n.example.com/webhook/pmw-analytics-health
VITE_API_BASE_URL=

# Request timeout for API calls, in milliseconds.
VITE_API_TIMEOUT_MS=15000
